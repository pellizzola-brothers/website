# Copie este arquivo para .env e preencha os valores antes de subir em produção

# ── Banco de dados (Railway / Supabase / Neon) ──────────────
DATABASE_URL=postgresql://user:password@host:5432/pauro

# ── Segurança JWT ───────────────────────────────────────────
# Gere uma string aleatória longa. Ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_uma_string_aleatoria_longa_aqui

# ── Servidor ────────────────────────────────────────────────
PORT=3000

# ── CORS ────────────────────────────────────────────────────
# Lista de origens permitidas separadas por vírgula.
# Deixe vazio para permitir tudo (útil em desenvolvimento local).
# Em produção, defina os domínios do seu frontend:
# ALLOWED_ORIGINS=https://meusite.com,https://www.meusite.com
ALLOWED_ORIGINS=
